# Database Configuration
# For local development (SQLite - no setup required):
DATABASE_URL=sqlite:///./ledgerflow.db

# For PostgreSQL (Docker/Production):
# DATABASE_URL=postgresql://ledgerflow:ledgerflow_secret@localhost:5432/ledgerflow

# JWT Configuration
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Application
APP_NAME=LedgerFlow
DEBUG=true
